{
  "name": "@nitrimandylis/dovetail",
  "version": "1.1.1",
  "description": "Find, back up, diff and restore macOS app configs through a local git store",
  "type": "module",
  "bin": {
    "dt": "dist/dt.js"
  },
  "files": [
    "dist",
    "man",
    "README.md",
    "LICENSE"
  ],
  "man": [
    "man/dt.1"
  ],
  "keywords": [
    "dotfiles",
    "config",
    "backup",
    "macos",
    "git",
    "launchd",
    "cli"
  ],
  "author": "nitrimandylis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nitrimandylis/dovetail.git"
  },
  "homepage": "https://github.com/nitrimandylis/dovetail#readme",
  "bugs": "https://github.com/nitrimandylis/dovetail/issues",
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "bun build dt.ts --target=node --format=esm --outfile dist/dt.js",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "compile": "bun build --compile dt.ts --outfile ~/.bun/bin/dt && mkdir -p $(brew --prefix)/share/man/man1 && cp man/dt.1 $(brew --prefix)/share/man/man1/ && ([ -d ~/.claude/skills ] && cp -R dovetail-cli ~/.claude/skills/ || true)"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
}
